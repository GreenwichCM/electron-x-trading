# Copy to services/db.env: the database login every service shares (recorder, orderentry,
# riskmonitor, and the `python -m trading_db` commands). git ignores services/db.env.
# Development: the SQL Server from `docker compose up -d sqlserver`. Shared server: its details instead.
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=trading
# Development uses sa; on a shared server, your own login (or one made with packages/db/dba-setup.sql)
DB_USER=sa
# In single quotes, so characters like # and $ are kept as typed. For sa: MSSQL_SA_PASSWORD in .env
DB_PASSWORD=''
# Encrypt the connection (TLS)
DB_ENCRYPT=Y
