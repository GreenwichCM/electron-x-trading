# Copy to services/db.power.env (never commit it): the production database, POWER on Azure SQL. Only
# Procfile.prod and the production commands in README.md load it; development and beta never do.
# Production refuses a database that already holds test data: see "Production" in README.md.
DB_HOST=
DB_PORT=1433
DB_NAME=POWER
DB_USER=
# In single quotes, so characters like # and $ are kept as typed
DB_PASSWORD=''
DB_ENCRYPT=Y
