# Copy to services/dropcopy/.env. These values connect to the local simulator.
DC_HOST=127.0.0.1
# Drop copy shares the order entry port
DC_PORT=13101
DC_SENDER=CM-HURON-DC01
DC_PASSWORD=sim
DC_TARGET=EXI
DC_HEARTBEAT_S=30
DC_TLS=N
DC_CA_CERT=certs/ca.crt
DC_CLIENT_CERT=certs/client.crt
DC_CLIENT_KEY=certs/client.key
DC_TLS_SERVER_NAME=
# Sequence numbers and the fill journal are saved here
DC_STATE_DIR=var/dc
# A position difference with orderentry that lasts longer than this trips the kill switch
DC_BREAK_GRACE_S=5
REDIS_URL=redis://127.0.0.1:6379/0
LOG_LEVEL=INFO
