# Copy to services/dropcopy/prod.env (never commit it). The ElectronX production drop copy session, from the
# production FIX connectivity sheet ("Drop Copy Sessions"): fill in the host, port, SenderCompID and password.
# Production refuses DC_TLS=N and a host on this machine (the simulator).
DC_HOST=
DC_PORT=
DC_SENDER=
DC_PASSWORD=
DC_TLS=Y
DC_CA_CERT=certs/prod/ca.crt
DC_CLIENT_CERT=certs/prod/client.crt
DC_CLIENT_KEY=certs/prod/client.key
# Production's own sequence numbers and fill journal, apart from the simulator's and beta's
DC_STATE_DIR=var/prod/dc
