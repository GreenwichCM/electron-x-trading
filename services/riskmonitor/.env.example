# Copy to services/riskmonitor/.env. The database login is in services/db.env.
# Loss and position limits per trader are in SQL Server (electronx.limits), reloaded this often (seconds)
RULES_REFRESH_S=5
# Books with a wider spread (USD/MWh) are not marked at their mid
RISK_MAX_SPREAD=5
# How often the snapshot is recalculated and published (seconds)
RISK_PUBLISH_S=1
REDIS_URL=redis://127.0.0.1:6379/0
LOG_LEVEL=INFO
