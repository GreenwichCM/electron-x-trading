# Copy to services/riskmonitor/.env
# Loss per trader (USD) that blocks them from trading. Placeholder until risk & compliance set it.
RISK_MAX_LOSS=5000
# Position per trader and contract (lots), shown as usage; orderentry enforces OE_MAX_POSITION
RISK_MAX_POSITION=50
# Books with a wider spread (USD/MWh) are not marked at their mid
RISK_MAX_SPREAD=5
# How often the snapshot is recalculated and published (seconds)
RISK_PUBLISH_S=1
REDIS_URL=redis://127.0.0.1:6379/0
LOG_LEVEL=INFO
