# Copy to services/api/.env
API_HOST=127.0.0.1
API_PORT=8000
REDIS_URL=redis://127.0.0.1:6379/0
LOG_LEVEL=INFO
# Development login with test users (alice, dave: traders; bob, erin: risk; carol: management).
# Only allowed while API_HOST is localhost. The database login is in services/db.env.
API_DEV_LOGIN=Y
# Any random string of 32+ characters; generate one with: openssl rand -hex 32
API_DEV_SECRET=
# orderentry's internal endpoint; the token must match OE_INTERNAL_TOKEN in services/orderentry/.env
OE_URL=http://127.0.0.1:8100
# N: record-only, no orderentry (orders are entered on the ElectronX screen). Production sets it in services/prod.env.
ORDER_ENTRY=Y
OE_INTERNAL_TOKEN=
