# Copy to services/api/.env
API_HOST=127.0.0.1
API_PORT=8000
REDIS_URL=redis://127.0.0.1:6379/0
LOG_LEVEL=INFO
# Development login with test users (alice, bob, carol). Only allowed while API_HOST is localhost.
API_DEV_LOGIN=Y
# Any random string of 32+ characters; generate one with: openssl rand -hex 32
API_DEV_SECRET=
