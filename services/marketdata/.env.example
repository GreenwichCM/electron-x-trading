# Copy to services/marketdata/.env. These values connect to the local simulator.
MD_HOST=127.0.0.1
MD_PORT=13001
MD_SENDER=HURON-MD01
MD_PASSWORD=sim
MD_TARGET=EXI
MD_HEARTBEAT_S=30
# Comma-separated; empty = every instrument the exchange lists
MD_SYMBOLS=
# How often to ask for the instrument list again, to pick up newly listed contracts (seconds)
MD_LIST_REFRESH_S=300
# How long to keep following a contract that left the list, waiting for its settlement (3 days)
MD_KEEP_UNSETTLED_S=259200
# Y for the real ElectronX gateway (mutual TLS); the simulator uses plain TCP
MD_TLS=N
MD_CA_CERT=certs/ca.crt
MD_CLIENT_CERT=certs/client.crt
MD_CLIENT_KEY=certs/client.key
MD_TLS_SERVER_NAME=
REDIS_URL=redis://127.0.0.1:6379/0
LOG_LEVEL=INFO
