# Copy to services/marketdata/prod.env (never commit it). The ElectronX production market data session, from
# the production FIX connectivity sheet ("Market Data Sessions"): fill in the host, port, SenderCompID and
# password. Production refuses MD_TLS=N and a host on this machine (the simulator).
MD_HOST=
MD_PORT=
MD_SENDER=
MD_PASSWORD=
MD_TLS=Y
MD_CA_CERT=certs/prod/ca.crt
MD_CLIENT_CERT=certs/prod/client.crt
MD_CLIENT_KEY=certs/prod/client.key
MD_SUBSCRIBE_PER_S=50
# Optional: the production Snapshot API (day-ahead marks, settlement prices). Its key is made on
# trade.electronx.com (Settings > REST API Snapshot); the beta key does not work here. Uncomment both to use it.
# SNAPSHOT_URL=https://trade.electronx.com
# SNAPSHOT_API_KEY=
