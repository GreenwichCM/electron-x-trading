# Copy to services/uat.env. Loaded by every service in Procfile.uat, after its own .env.
# It keeps the ElectronX demo apart from the simulator: its own Redis database and its own SQL database.
# ElectronX beta (beta.electronx.com). Every Redis database, state folder and SQL database is marked with
# the environment that uses it, and the others refuse it.
TRADING_ENV=beta
REDIS_URL=redis://127.0.0.1:6379/1
DB_NAME=trading_uat
# The local SQL Server from docker compose, whatever services/db.env points at (it may be a shared
# company database, where you cannot create databases and should not put test data).
# DB_PASSWORD is MSSQL_SA_PASSWORD from .env.
DB_HOST=127.0.0.1
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
