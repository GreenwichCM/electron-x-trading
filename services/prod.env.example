# Copy to services/prod.env. Loaded by every service in Procfile.prod, after its own .env.
TRADING_ENV=production
# Production's own Redis database: development uses 0, beta 1. It must be empty the first time.
REDIS_URL=redis://127.0.0.1:6379/2
# Record-only: orders are entered on the ElectronX screen; the app shows no order ticket and sends nothing
ORDER_ENTRY=N
