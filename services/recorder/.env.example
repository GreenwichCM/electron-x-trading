# Copy to services/recorder/.env
# SQL Server: the one from `docker compose up -d sqlserver` in development
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=trading
# Development uses the sa login; production gets its own login with access to this database only
DB_USER=sa
# The same value as MSSQL_SA_PASSWORD in the .env next to compose.yaml
DB_PASSWORD=
# Encrypt the connection (TLS)
DB_ENCRYPT=Y
REDIS_URL=redis://127.0.0.1:6379/0
# Stream entries written per transaction
RECORDER_BATCH=500
LOG_LEVEL=INFO
