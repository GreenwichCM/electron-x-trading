# Copy to services/orderentry/uat.env (never commit it). The ElectronX demo order entry session, from the
# ElectronX FIX connectivity sheet: fill in the password ("Order Entry Sessions") and OE_DEFAULT_TRADER.
OE_HOST=206.109.100.83
OE_PORT=13101
OE_SENDER=D-HURON-01-OE01
OE_PASSWORD=
OE_TLS=Y
OE_CA_CERT=certs/ca.crt
OE_CLIENT_CERT=certs/client.crt
OE_CLIENT_KEY=certs/client.key
OE_ACCOUNT=TA-HURON-00001
OE_CAPACITY=2
# SenderSubID for a trader without their own exchange_trader_id: one of the "Authorized Trading Users"
# (an email address) on the sheet. ElectronX rejects orders from anyone else.
OE_DEFAULT_TRADER=
# Its own sequence numbers and saved orders, apart from the simulator's
OE_STATE_DIR=var/uat/oe
