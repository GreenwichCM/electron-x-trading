# Copy to services/orderentry/uat.env (never commit it). The ElectronX demo order entry session, from the
# ElectronX FIX connectivity sheet: fill in the password ("Order Entry Sessions").
OE_HOST=206.109.100.83
OE_PORT=13101
OE_SENDER=D-HURON-01-OE01
OE_PASSWORD=
OE_TLS=Y
OE_CA_CERT=certs/beta/ca.crt
OE_CLIENT_CERT=certs/beta/client.crt
OE_CLIENT_KEY=certs/beta/client.key
# Who trades is not set here: each order goes out under the trader's own ElectronX login. The
# "Authorized Trading Users" and the account on the sheet go in SQL Server (electronx.users and
# electronx.accounts); ElectronX rejects orders from anyone else.
# Its own sequence numbers and saved orders, apart from the simulator's
OE_STATE_DIR=var/uat/oe
