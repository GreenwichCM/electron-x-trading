# Copy to services/orderentry/.env. These values connect to the local simulator.
OE_HOST=127.0.0.1
OE_PORT=13101
OE_SENDER=D-HURON-01-OE01
OE_PASSWORD=sim
OE_TARGET=EXI
OE_HEARTBEAT_S=30
OE_TLS=N
OE_CA_CERT=certs/ca.crt
OE_CLIENT_CERT=certs/client.crt
OE_CLIENT_KEY=certs/client.key
OE_TLS_SERVER_NAME=
# Sequence numbers, orders and positions are saved here so a restart carries on where it stopped
OE_STATE_DIR=var/oe
# Each order goes out under the trader's own ElectronX login (SenderSubID 50), on an ElectronX account
# they may trade on: users, accounts, who may trade what, and the limits are all in SQL Server
# (electronx.users, user_roles, accounts, account_access, entitlements, limits),
# reloaded this often (seconds). The database login is in services/db.env.
RULES_REFRESH_S=5
# Messages per second; ElectronX allows 100 on the order entry session
OE_RATE_LIMIT=90
REDIS_URL=redis://127.0.0.1:6379/0
# Internal endpoint for the api (localhost only). The api's OE_INTERNAL_TOKEN must match.
OE_CONTROL_HOST=127.0.0.1
OE_CONTROL_PORT=8100
# Any random string of 32+ characters; generate one with: openssl rand -hex 32
OE_INTERNAL_TOKEN=
LOG_LEVEL=INFO
