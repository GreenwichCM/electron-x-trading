# Copy to services/orderentry/.env. These values connect to the local simulator.
OE_HOST=127.0.0.1
OE_PORT=13101
OE_SENDER=D-HURON-01-OE01
OE_PASSWORD=sim
OE_TARGET=EXI
OE_HEARTBEAT_S=30
OE_TLS=N
OE_CA_CERT=certs/ca.crt
OE_CLIENT_CERT=certs/client.crt
OE_CLIENT_KEY=certs/client.key
OE_TLS_SERVER_NAME=
# Sequence numbers are saved here so a restart resumes the session
OE_STATE_DIR=var/oe
OE_ACCOUNT=TA-HURON-00001
OE_CAPACITY=2
# ElectronX trader id sent in SenderSubID(50): one per user if they are registered, else the default
OE_DEFAULT_TRADER=trader@example.com
OE_TRADER_IDS=
# Pre-trade limits per trader (placeholders until risk & compliance set them)
OE_MAX_ORDER_QTY=10
OE_MAX_ORDER_NOTIONAL=5000
OE_MAX_OPEN_ORDERS=20
OE_MAX_POSITION=50
# Messages per second; ElectronX allows 100 on the order entry session
OE_RATE_LIMIT=90
REDIS_URL=redis://127.0.0.1:6379/0
# Internal endpoint for the api (localhost only). The api's OE_INTERNAL_TOKEN must match.
OE_CONTROL_HOST=127.0.0.1
OE_CONTROL_PORT=8100
# Any random string of 32+ characters; generate one with: openssl rand -hex 32
OE_INTERNAL_TOKEN=
LOG_LEVEL=INFO
